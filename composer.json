{
    "name": "ph20sr/asaas-php",
    "description": "SDK PHP para a API v3 do Asaas: clientes, cobranças (Pix, boleto, cartão), assinaturas e webhooks, com paginação, retries e erros tipados.",
    "type": "library",
    "license": "MIT",
    "keywords": ["asaas", "pix", "boleto", "pagamentos", "assinaturas", "webhook", "sdk"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Ph20sr\\Asaas\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ph20sr\\Asaas\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
